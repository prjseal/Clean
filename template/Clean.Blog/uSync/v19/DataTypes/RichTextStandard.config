    "Umb.Tiptap.TextAlign",
    "Umb.Tiptap.MediaUpload",
    "Umb.Tiptap.Heading",
    "Umb.Tiptap.Bold",
    "Umb.Tiptap.OrderedList",
    "Umb.Tiptap.Italic",
    "Umb.Tiptap.BulletList",
    "Umb.Tiptap.Anchor"
  ],
  "maxImageSize": 500,
  "overlaySize": "medium",
  "stylesheets": [
    "/dropdownStyles.css"
  ],
  "toolbar": [
    [
      [
        "Umb.Tiptap.Toolbar.SourceEditor",
        "Umb.Tiptap.Toolbar.ClearFormatting"
      ],
      [
        "Umb.Tiptap.Toolbar.Heading2",
